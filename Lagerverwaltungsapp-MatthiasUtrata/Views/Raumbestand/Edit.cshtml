@model Lagerverwaltungsapp_MatthiasUtrata.Models.Raumbestand

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Raumbestand</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="GegenstandID" />
            <input type="hidden" asp-for="RaumID" />
            <div class="form-group">
                <label asp-for="GegenstandID" class="control-label"></label>
                <input value="@Model.GegenstandID" class="form-control" disabled />
            </div>
            <div class="form-group">
                <label asp-for="RaumID" class="control-label"></label>
                <input value="@Model.RaumID" class="form-control" disabled />
            </div>
            <div class="form-group">
                <label asp-for="Menge" class="control-label"></label>
                <input asp-for="Menge" class="form-control" />
                <span asp-validation-for="Menge" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
