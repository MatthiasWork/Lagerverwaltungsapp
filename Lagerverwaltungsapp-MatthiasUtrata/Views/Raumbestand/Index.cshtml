@model IEnumerable<Lagerverwaltungsapp_MatthiasUtrata.Models.Raumbestand>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.GegenstandID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gegenstand.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RaumID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Menge)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.GegenstandID)
            </td>
            <td>
                @Html.DisplayFor(model => item.Gegenstand.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.RaumID)
            </td>
            <td>
                @Html.DisplayFor(model => item.Menge)
            </td>
            <td>
                <a asp-action="Edit" asp-route-gegenstandID="@item.GegenstandID" asp-route-raumID="@item.RaumID">Edit</a> |
                <a asp-action="Details" asp-route-gegenstandID="@item.GegenstandID" asp-route-raumID="@item.RaumID">Details</a> |
                <a asp-action="Delete" asp-route-gegenstandID="@item.GegenstandID" asp-route-raumID="@item.RaumID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
