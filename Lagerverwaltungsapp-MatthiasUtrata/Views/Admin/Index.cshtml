@model Lagerverwaltungsapp_MatthiasUtrata.Models.AdminUebersichtViewModel

@{
    ViewData["Title"] = "Adminübersicht";
}

<h1>Adminübersicht</h1>
<hr />

@* Rückmeldungen aus dem PersonController (Anlegen, Speichern, Löschen) *@
<partial name="_Meldungen" />

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 card-subtitle text-muted">Benutzer</h2>
                <p class="display-6 mb-0">@Model.AnzahlBenutzer</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 card-subtitle text-muted">Administratoren</h2>
                <p class="display-6 mb-0">@Model.AnzahlAdmins</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 card-subtitle text-muted">Rollen</h2>
                <p class="display-6 mb-0">@Model.AnzahlRollen</p>
                <a asp-controller="Rolle" asp-action="Index" class="card-link">Rollen verwalten</a>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Benutzerverwaltung</h2>
    <a asp-controller="Person" asp-action="Create" class="btn btn-primary">Neuer Benutzer</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input asp-for="Suche" class="form-control" placeholder="Name, Benutzername oder E-Mail" aria-label="Suche" />
    </div>
    <div class="col-md-3">
        <select asp-for="RolleID" asp-items="Model.Rollen" class="form-select" aria-label="Rolle">
            <option value="">Alle Rollen</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filtern</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Zurücksetzen</a>
    </div>
</form>

@if (!Model.Benutzer.Any())
{
    <p class="text-muted">Keine Benutzer gefunden.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Benutzername</th>
                    <th>E-Mail</th>
                    <th>Rolle</th>
                    <th class="text-end">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var benutzer in Model.Benutzer)
                {
                    var istAngemeldet = benutzer.ID == Model.AngemeldeteBenutzerID;
                    <tr>
                        <td>
                            @benutzer.Vorname @benutzer.Nachname
                            @if (istAngemeldet)
                            {
                                <span class="badge bg-info text-dark">Du</span>
                            }
                        </td>
                        <td>@benutzer.Username</td>
                        <td><a href="mailto:@benutzer.Email">@benutzer.Email</a></td>
                        <td>
                            <span class="badge @(benutzer.Rolle.Admin ? "bg-primary" : "bg-secondary")">@benutzer.Rolle.Name</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Person" asp-action="Details" asp-route-id="@benutzer.ID" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-controller="Person" asp-action="Edit" asp-route-id="@benutzer.ID" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
                            @if (!istAngemeldet)
                            {
                                <a asp-controller="Person" asp-action="Delete" asp-route-id="@benutzer.ID" class="btn btn-sm btn-outline-danger">Löschen</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@Model.Benutzer.Count von @Model.AnzahlBenutzer Benutzern angezeigt</p>
}
