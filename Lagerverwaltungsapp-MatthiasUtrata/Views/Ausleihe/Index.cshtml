@model Lagerverwaltungsapp_MatthiasUtrata.Models.AusborgenViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Neue Ausleihe";

    // Ohne eigenen Raum gibt der Controller kein Model mit, dann zeigt die Seite nur einen Hinweis
    var hatRaum = Model != null;
}

<div class="seite ausleihe">
    <div class="seiten-kopf d-none d-lg-flex">
        <div>
            <h1>Neue Ausleihe</h1>
            @if (hatRaum)
            {
                <div class="seiten-untertitel">Geräte aus Raum @Model!.VonRaum.ID an einen anderen Raum ausleihen.</div>
            }
        </div>
        @if (hatRaum)
        {
            @* Schritte wie im Design; das Skript setzt sie je nach Auswahl auf erledigt bzw. aktuell *@
            <ol class="schritte" aria-label="Schritte">
                <li class="schritt aktuell" data-schritt>
                    <span class="schritt-marke"><span data-marke="nummer">1</span><span data-marke="haken" hidden><i data-lucide="check"></i></span></span>Geräte
                </li>
                <li class="schritt-linie" aria-hidden="true"></li>
                <li class="schritt" data-schritt>
                    <span class="schritt-marke"><span data-marke="nummer">2</span><span data-marke="haken" hidden><i data-lucide="check"></i></span></span>Freigabe
                </li>
            </ol>
        }
    </div>
    <div class="transfer-kopf-mobil d-lg-none">
        <a class="abbrechen-link" asp-controller="Home" asp-action="Index">Abbrechen</a>
        <h1 class="transfer-titel-mobil">Neue Ausleihe</h1>
    </div>

    @if (!hatRaum)
    {
        <p class="text-muted mb-0">
            Ausleihen kann nur, wer für einen Raum verantwortlich ist, da die Geräte aus diesem Raum gebucht werden.
            Ein Admin kann Ihnen in der Raumliste einen Raum zuweisen.
        </p>
        <div>
            <a class="btn btn-outline-secondary" asp-controller="Gegenstand" asp-action="Index">Zum Katalog</a>
        </div>
    }
    else
    {
        var vonRaum = Model!.VonRaum;
        var verantwortlich = vonRaum.Person?.VollerName ?? "–";
        var rolle = User.FindFirstValue(ClaimTypes.Role);

        // Nach einem Fehler die bisherige Auswahl wieder anzeigen; das Skript unten hält die Werte danach aktuell
        var zielraum = Model.Raeume.FirstOrDefault(r => r.ID == Model.NachRaumID);
        var anzahlGewaehlt = Model.Mengen.Count(m => m.Value > 0);
        string ziel;
        if (zielraum != null)
        {
            ziel = $"{zielraum.ID} · {zielraum.Raumart.Name}";
        }
        else
        {
            ziel = "–";
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        @* Ohne _ValidationScriptsPartial: Zielraum, Bewegungsart und Mengen (min/max) prüft der Browser selbst, alles andere Controller und LagerService *@
        <form asp-action="Index" method="post" id="ausleiheFormular">
            <div class="ausleihe-raster">
                <div class="ausleihe-auswahl">
                    @* Wohin: Die Person des Zielraums bestätigt die Übernahme, wie bei jedem Transfer *@
                    <div class="ausleihe-ziel">
                        <div>
                            <label class="form-label" asp-for="NachRaumID">Ausleihen an</label>
                            <select asp-for="NachRaumID" class="form-select" required>
                                <option value="">Raum auswählen</option>
                                @foreach (var raum in Model.Raeume)
                                {
                                    // Der Controller lädt nur Räume mit verantwortlicher Person
                                    var person = raum.Person!;
                                    <option value="@raum.ID" data-raumart="@raum.Raumart.Name"
                                            data-person="@person.Vorname @person.Nachname" data-initialen="@person.Initialen">
                                        @raum.ID · @raum.Raumart.Name · @person.Vorname @person.Nachname
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="NachRaumID" class="text-danger"></span>
                        </div>
                        <div>
                            <label class="form-label" asp-for="BewegungsartID"></label>
                            <select asp-for="BewegungsartID" asp-items="Model.Bewegungsarten" class="form-select" required></select>
                            <span asp-validation-for="BewegungsartID" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="geraete-liste">
                        <h4>Geräte · <span data-ausleihe="anzahl">@anzahlGewaehlt</span></h4>

                        @* Alle Geräte des eigenen Raums sind da, aber nur die ausgewählten sichtbar; nicht ausgewählte Felder
                           sind deaktiviert und werden daher nicht mitgeschickt. Hinzufügen über die Suche darunter *@
                        @foreach (var bestand in Model.Bestand)
                        {
                            var gegenstand = bestand.Gegenstand;
                            Model.Mengen.TryGetValue(gegenstand.ID, out var menge);
                            var gewaehlt = menge > 0;
                            if (!gewaehlt)
                            {
                                // Vorschlag, falls das Gerät über die Suche hinzugefügt wird
                                menge = 1;
                            }
                            <div class="geraet-zeile" hidden="@(!gewaehlt)"
                                 data-suchtext="@($"{gegenstand.Name} {gegenstand.Seriennummer} {gegenstand.Kategorie.Name}".ToLowerInvariant())"
                                 data-name="@gegenstand.Name" data-info="@(gegenstand.Seriennummer ?? $"{bestand.Menge} Stück im Raum")">
                                <div class="geraet-bild" aria-hidden="true"></div>
                                <div>
                                    <div class="fw-medium">@gegenstand.Name</div>
                                    <div class="geraet-zeile-info">@(gegenstand.Seriennummer ?? gegenstand.Kategorie.Name) · @vonRaum.ID</div>
                                </div>
                                @* Ein Gerät mit Seriennummer wird immer einzeln gebucht (Menge 1), sonst die Menge eingeben *@
                                @if (gegenstand.Seriennummer != null)
                                {
                                    <span class="tag tag-accent d-none d-lg-inline-flex">Verfügbar</span>
                                    <input type="hidden" name="Mengen[@gegenstand.ID]" value="1" disabled="@(!gewaehlt)" />
                                }
                                else
                                {
                                    <span class="menge-auswahl">
                                        <input type="number" class="form-control" name="Mengen[@gegenstand.ID]" value="@menge"
                                               min="1" max="@bestand.Menge" step="1" disabled="@(!gewaehlt)" aria-label="Menge von @gegenstand.Name" />
                                        <span>von @bestand.Menge</span>
                                    </span>
                                }
                                <button type="button" class="entfernen" data-entfernen aria-label="@gegenstand.Name entfernen"><i data-lucide="x"></i></button>
                            </div>
                        }
                        <p class="geraete-leer" hidden="@(anzahlGewaehlt > 0)">
                            @if (Model.Bestand.Any())
                            {
                                <text>Noch keine Geräte ausgewählt.</text>
                            }
                            else
                            {
                                <text>Im Raum @vonRaum.ID liegt derzeit nichts, das ausgeliehen werden kann.</text>
                            }
                        </p>

                        @if (Model.Bestand.Any())
                        {
                            <div class="geraet-hinzufuegen">
                                <i data-lucide="scan-line"></i>
                                <input type="search" id="geraetSuche" placeholder="Gerät scannen oder Name/Seriennummer eingeben" autocomplete="off"
                                       aria-label="Gerät hinzufügen" aria-controls="geraetVorschlaege" />
                                <div class="vorschlaege" id="geraetVorschlaege" hidden></div>
                            </div>
                        }
                    </div>
                </div>

                <aside class="blueprint zusammenfassung">
                    <span class="card-kicker">Zusammenfassung</span>
                    <div class="angabe">
                        <span class="angabe-label">Von</span>
                        <span class="fw-medium">@vonRaum.ID · @vonRaum.Raumart.Name</span>
                        <span class="nebeninfo">@verantwortlich · @rolle</span>
                    </div>
                    <div class="angabe">
                        <span class="angabe-label">An</span>
                        <span class="fw-medium" data-ausleihe="ziel">@ziel</span>
                    </div>
                    <div class="angabe freigabe-liste">
                        <span class="angabe-label">Benötigte Freigabe</span>
                        <div class="freigeber" data-ausleihe="freigeber" hidden="@(zielraum == null)">
                            <span class="avatar avatar-sm" aria-hidden="true" data-ausleihe="initialen">@zielraum?.Person?.Initialen</span>
                            <span>
                                <span data-ausleihe="person">@zielraum?.Person?.Vorname @zielraum?.Person?.Nachname</span><br />
                                <span class="nebeninfo" data-ausleihe="freigabe-info"></span>
                            </span>
                        </div>
                        <span class="nebeninfo" data-ausleihe="keine-freigabe" hidden="@(zielraum != null)">Noch kein Raum ausgewählt.</span>
                    </div>
                    <p class="hinweis-klein">
                        <i data-lucide="info"></i>
                        <span>
                            Beim Absenden werden die Geräte aus Raum @vonRaum.ID abgebucht. Sie sind unterwegs, bis die Person des Zielraums
                            die Übernahme unter „Freigaben“ bestätigt. Bis dahin können Sie die Ausleihe unter „Mein Raum“ zurückziehen.
                        </span>
                    </p>
                    <button type="submit" class="btn btn-primary btn-cta" disabled="@(!Model.Bestand.Any())">Freigabe anfragen</button>
                </aside>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        // Geräteauswahl wie beim Transfer: ausgewählte Geräte als Liste, weitere über die Suche hinzufügen, mit × entfernen.
        // Dazu die Zusammenfassung (Zielraum, benötigte Freigabe) und die Schritte oben
        (function () {
            var formular = document.getElementById('ausleiheFormular');
            if (!formular) {
                return;
            }
            var zeilen = Array.prototype.slice.call(formular.querySelectorAll('.geraet-zeile'));
            var suchfeld = document.getElementById('geraetSuche');
            var vorschlaege = document.getElementById('geraetVorschlaege');
            var raumAuswahl = formular.querySelector('select[name="NachRaumID"]');

            function feld(name) {
                return formular.querySelector('[data-ausleihe="' + name + '"]');
            }

            // Zielraum und die Person, die die Übernahme bestätigen muss
            function freigabeZeigen(anzahl) {
                var raum = raumAuswahl.selectedOptions[0];
                var gewaehlt = raum && raum.value !== '';
                feld('freigeber').hidden = !gewaehlt;
                feld('keine-freigabe').hidden = gewaehlt;
                if (!gewaehlt) {
                    feld('ziel').textContent = '–';
                    return false;
                }

                feld('ziel').textContent = raum.value + ' · ' + raum.dataset.raumart;
                feld('initialen').textContent = raum.dataset.initialen;
                feld('person').textContent = raum.dataset.person;
                var geraete;
                if (anzahl === 1) {
                    geraete = '1 Gerät';
                } else {
                    geraete = anzahl + ' Geräte';
                }
                feld('freigabe-info').textContent = 'Raum ' + raum.value + ' · ' + geraete;
                return true;
            }

            // Schritte: erledigt ist, was ausgefüllt ist, aktuell der erste offene Schritt (zuletzt "Freigabe")
            function schritteZeigen(erledigt) {
                var schritte = document.querySelectorAll('[data-schritt]');
                var aktuell = erledigt.indexOf(false);
                if (aktuell === -1) {
                    // Alles erledigt: der letzte Schritt bleibt aktuell
                    aktuell = schritte.length - 1;
                }
                schritte.forEach(function (schritt, i) {
                    var fertig = erledigt[i] === true;
                    var istAktuell = i === aktuell;
                    schritt.classList.toggle('erledigt', fertig);
                    schritt.classList.toggle('aktuell', istAktuell);
                    schritt.querySelector('[data-marke="nummer"]').hidden = fertig;
                    schritt.querySelector('[data-marke="haken"]').hidden = !fertig;
                    if (istAktuell) {
                        schritt.setAttribute('aria-current', 'step');
                    } else {
                        schritt.removeAttribute('aria-current');
                    }
                });
            }

            function aktualisieren() {
                var anzahl = zeilen.filter(function (zeile) { return !zeile.hidden; }).length;
                feld('anzahl').textContent = anzahl;
                formular.querySelector('.geraete-leer').hidden = anzahl > 0;
                var zielGewaehlt = freigabeZeigen(anzahl);
                // "Freigabe" ist erst nach dem Absenden erledigt
                schritteZeigen([anzahl > 0 && zielGewaehlt, false]);
            }

            // Zeile zeigen und ihre Felder mitschicken oder ausblenden und nicht mitschicken
            function auswaehlen(zeile, gewaehlt) {
                zeile.hidden = !gewaehlt;
                zeile.querySelectorAll('input').forEach(function (eingabe) {
                    eingabe.disabled = !gewaehlt;
                });
                aktualisieren();
            }

            function hinzufuegen(zeile) {
                auswaehlen(zeile, true);
                suchfeld.value = '';
                vorschlaege.hidden = true;
                var menge = zeile.querySelector('input[type="number"]');
                (menge || suchfeld).focus();
            }

            // Vorschläge: noch nicht ausgewählte Geräte, deren Name, Seriennummer oder Kategorie den Suchbegriff enthält
            function vorschlaegeZeigen() {
                var begriff = suchfeld.value.trim().toLowerCase();
                vorschlaege.replaceChildren();
                if (begriff === '') {
                    vorschlaege.hidden = true;
                    return;
                }

                var treffer = zeilen.filter(function (zeile) {
                    return zeile.hidden && zeile.dataset.suchtext.indexOf(begriff) !== -1;
                }).slice(0, 8);

                treffer.forEach(function (zeile) {
                    var knopf = document.createElement('button');
                    knopf.type = 'button';
                    knopf.className = 'vorschlag';
                    var name = document.createElement('span');
                    name.textContent = zeile.dataset.name;
                    var info = document.createElement('span');
                    info.className = 'nebeninfo';
                    info.textContent = zeile.dataset.info;
                    knopf.append(name, info);
                    knopf.addEventListener('click', function () {
                        hinzufuegen(zeile);
                    });
                    vorschlaege.append(knopf);
                });

                if (treffer.length === 0) {
                    var leer = document.createElement('div');
                    leer.className = 'vorschlag-leer';
                    leer.textContent = 'Kein passendes Gerät in diesem Raum';
                    vorschlaege.append(leer);
                }
                vorschlaege.hidden = false;
            }

            zeilen.forEach(function (zeile) {
                zeile.querySelector('[data-entfernen]').addEventListener('click', function () {
                    auswaehlen(zeile, false);
                });
            });

            if (suchfeld) {
                suchfeld.addEventListener('input', vorschlaegeZeigen);
                suchfeld.addEventListener('keydown', function (e) {
                    // Enter übernimmt den ersten Vorschlag (z. B. nach dem Scannen einer Seriennummer) statt das Formular abzuschicken
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        var erster = vorschlaege.querySelector('.vorschlag');
                        if (erster) {
                            erster.click();
                        }
                    } else if (e.key === 'Escape') {
                        vorschlaege.hidden = true;
                    }
                });
                document.addEventListener('click', function (e) {
                    if (!e.target.closest('.geraet-hinzufuegen')) {
                        vorschlaege.hidden = true;
                    }
                });
            }

            raumAuswahl.addEventListener('change', aktualisieren);
            aktualisieren();
        })();
    </script>
}
