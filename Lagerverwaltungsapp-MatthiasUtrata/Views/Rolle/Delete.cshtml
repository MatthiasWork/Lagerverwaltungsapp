@model Lagerverwaltungsapp_MatthiasUtrata.Models.Rolle

@{
    ViewData["Title"] = "Rolle löschen";
}

<h1>Rolle löschen</h1>
<hr />

<h3>Soll diese Rolle wirklich gelöscht werden?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Admin-Rechte</dt>
        <dd class="col-sm-10">@(Model.Admin ? "Ja" : "Nein")</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Löschen" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Zurück zur Übersicht</a>
    </form>
</div>
