@model Lagerverwaltungsapp_MatthiasUtrata.Models.Rolle

@{
    ViewData["Title"] = "Neue Rolle";
}

<h1>Neue Rolle</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-check mt-3">
                <input asp-for="Admin" class="form-check-input" />
                <label asp-for="Admin" class="form-check-label"></label>
                <div class="form-text">Personen mit dieser Rolle sehen die Benutzerverwaltung und alle Stammdaten.</div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Anlegen" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
