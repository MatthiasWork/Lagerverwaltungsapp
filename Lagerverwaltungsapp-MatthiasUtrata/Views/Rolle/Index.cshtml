@model IEnumerable<Lagerverwaltungsapp_MatthiasUtrata.Models.Rolle>

@{
    ViewData["Title"] = "Rollen";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>Rollen</h1>
    <a asp-action="Create" class="btn btn-primary"><i data-lucide="plus"></i>Neue Rolle</a>
</div>
<hr />

<p class="text-muted">
    Personen mit einer Rolle mit Admin-Rechten sehen die Benutzerverwaltung und alle Stammdaten. Eine geänderte Rolle gilt ab der nächsten Anmeldung.
</p>

<partial name="_Meldungen" />

@if (!Model.Any())
{
    <p class="text-muted">Es gibt noch keine Rollen.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Admin-Rechte</th>
                    <th class="text-end">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rolle in Model)
                {
                    <tr>
                        <td>@rolle.Name</td>
                        <td>@(rolle.Admin ? "Ja" : "Nein")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@rolle.ID" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@rolle.ID" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
                            <a asp-action="Delete" asp-route-id="@rolle.ID" class="btn btn-sm btn-outline-danger">Löschen</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Zurück zu den Benutzern</a>
