@model Lagerverwaltungsapp_MatthiasUtrata.Models.Person

@{
    ViewData["Title"] = "Benutzer löschen";
    var loeschHindernis = ViewData["LoeschHindernis"] as string;
    var anzahlRaeume = (int)ViewData["AnzahlRaeume"]!;
}

<h1>Benutzer löschen</h1>
<hr />

@if (loeschHindernis != null)
{
    <div class="alert alert-danger">@loeschHindernis</div>
}
else
{
    <h3>Soll dieser Benutzer wirklich gelöscht werden?</h3>
    @if (anzahlRaeume > 0)
    {
        <div class="alert alert-warning">
            Der Benutzer ist für @anzahlRaeume Raum/Räume zuständig. Die Räume bleiben erhalten, verlieren aber die Zuordnung.
        </div>
    }
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Vorname</dt>
        <dd class="col-sm-10">@Model.Vorname</dd>

        <dt class="col-sm-2">Nachname</dt>
        <dd class="col-sm-10">@Model.Nachname</dd>

        <dt class="col-sm-2">Benutzername</dt>
        <dd class="col-sm-10">@Model.Username</dd>

        <dt class="col-sm-2">E-Mail</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Rolle</dt>
        <dd class="col-sm-10">@Model.Rolle.Name</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        @if (loeschHindernis == null)
        {
            <input type="submit" value="Löschen" class="btn btn-danger" />
        }
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Zurück zur Übersicht</a>
    </form>
</div>
