@model Lagerverwaltungsapp_MatthiasUtrata.Models.Gegenstand

@{
    ViewData["Title"] = "Gegenstand löschen";
    var loeschHindernis = ViewData["LoeschHindernis"] as string;
}

<h1>Gegenstand löschen</h1>
<hr />

@if (loeschHindernis != null)
{
    <div class="alert alert-danger">@loeschHindernis</div>
}
else
{
    <h3>Soll dieser Gegenstand wirklich gelöscht werden?</h3>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Bezeichnung</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Seriennummer</dt>
        <dd class="col-sm-10">@(Model.Seriennummer ?? "keine")</dd>

        <dt class="col-sm-2">Kategorie</dt>
        <dd class="col-sm-10">@Model.Kategorie.Name</dd>

        <dt class="col-sm-2">Hersteller</dt>
        <dd class="col-sm-10">@Model.Hersteller.Name</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        @if (loeschHindernis == null)
        {
            <input type="submit" value="Löschen" class="btn btn-danger" />
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Zurück zur Übersicht</a>
    </form>
</div>
