@model Lagerverwaltungsapp_MatthiasUtrata.Models.Gegenstand

@{
    ViewData["Title"] = "Neuer Gegenstand";
}

<h1>Neuer Gegenstand</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <p class="text-muted">
            Hier werden nur die Stammdaten erfasst. Der Bestand ändert sich ausschließlich über Lagerbewegungen.
        </p>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Seriennummer" class="control-label"></label>
                <input asp-for="Seriennummer" class="form-control" />
                <span asp-validation-for="Seriennummer" class="text-danger"></span>
                <div class="form-text">
                    Mit Seriennummer steht der Eintrag für genau ein Gerät. Ohne Seriennummer ist er ein Artikel,
                    von dem es beliebig viele Stück geben kann (z. B. Patchkabel).
                </div>
            </div>

            <div class="form-group">
                <label asp-for="KategorieID" class="control-label"></label>
                <select asp-for="KategorieID" class="form-select" asp-items="ViewBag.KategorieID"></select>
                <span asp-validation-for="KategorieID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HerstellerID" class="control-label"></label>
                <select asp-for="HerstellerID" class="form-select" asp-items="ViewBag.HerstellerID"></select>
                <span asp-validation-for="HerstellerID" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Anlegen" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
