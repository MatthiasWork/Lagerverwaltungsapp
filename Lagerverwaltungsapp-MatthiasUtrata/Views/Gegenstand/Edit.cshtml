@model Lagerverwaltungsapp_MatthiasUtrata.Models.Gegenstand

@{
    ViewData["Title"] = "Gegenstand bearbeiten";
}

<h1>Gegenstand bearbeiten</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Seriennummer" class="control-label"></label>
                <input asp-for="Seriennummer" class="form-control" />
                <span asp-validation-for="Seriennummer" class="text-danger"></span>
                <div class="form-text">
                    Ob der Gegenstand eine Seriennummer hat, kann nur geändert werden, solange er weder Bestand noch Lagerbewegungen hat.
                </div>
            </div>

            <div class="form-group">
                <label asp-for="KategorieID" class="control-label"></label>
                <select asp-for="KategorieID" class="form-select" asp-items="ViewBag.KategorieID"></select>
                <span asp-validation-for="KategorieID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HerstellerID" class="control-label"></label>
                <select asp-for="HerstellerID" class="form-select" asp-items="ViewBag.HerstellerID"></select>
                <span asp-validation-for="HerstellerID" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Speichern" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
