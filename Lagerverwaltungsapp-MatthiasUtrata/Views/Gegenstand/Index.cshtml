@model Lagerverwaltungsapp_MatthiasUtrata.Models.GegenstandUebersichtViewModel

@{
    ViewData["Title"] = "Katalog";

    // Unter dem Namen: Kategorie, bei Gegenständen ohne Seriennummer auch die Stückzahl
    string Zusatz(KatalogEintrag eintrag)
    {
        if (eintrag.Gegenstand.Seriennummer == null && eintrag.Stueck > 1)
        {
            return $"{eintrag.Gegenstand.Kategorie.Name} · {eintrag.Stueck} Stück";
        }
        return eintrag.Gegenstand.Kategorie.Name;
    }

    var statusWerte = new[] { GegenstandUebersichtViewModel.Verfuegbar, GegenstandUebersichtViewModel.InAusleihe, GegenstandUebersichtViewModel.KeinBestand };
}

<div class="seite katalog">
    <div class="seiten-kopf">
        <div>
            <h1>Katalog</h1>
            <div class="seiten-untertitel d-none d-lg-block">@Model.AnzahlGesamt Geräte in @Model.AnzahlRaeume Räumen</div>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="seiten-aktionen d-none d-lg-flex">
                <a class="btn btn-primary" asp-action="Create"><i data-lucide="plus"></i>Gerät erfassen</a>
            </div>
        }
    </div>

    <partial name="_Meldungen" />

    @* Suche mit Enter, Kategorie, Raum und Status sofort bei Änderung (site.js). Die Kategorie gibt es auch mobil *@
    <form class="katalog-filter" asp-action="Index" method="get">
        <div class="feld-mit-icon katalog-suche">
            <input asp-for="Suche" class="form-control" placeholder="Name, Seriennummer oder Raum" aria-label="Suche" />
            <i data-lucide="search"></i>
        </div>
        <select asp-for="KategorieID" class="filter-auswahl" data-auto-absenden aria-label="Kategorie">
            <option value="">Kategorie: alle</option>
            @foreach (var kategorie in Model.Kategorien)
            {
                <option value="@kategorie.ID">Kategorie: @kategorie.Name</option>
            }
        </select>
        @* Hersteller nur, wenn man über einen Link bei den Herstellern kommt, damit dieser Filter sichtbar ist und aufgehoben werden kann *@
        @if (Model.HerstellerID != null)
        {
            <select asp-for="HerstellerID" class="filter-auswahl" data-auto-absenden aria-label="Hersteller">
                <option value="">Hersteller: alle</option>
                @foreach (var hersteller in Model.Hersteller)
                {
                    <option value="@hersteller.ID">Hersteller: @hersteller.Name</option>
                }
            </select>
        }

        <select asp-for="RaumID" class="filter-auswahl ms-auto d-none d-lg-block" data-auto-absenden aria-label="Raum">
            <option value="">Raum: alle</option>
            @foreach (var raumID in Model.Raeume)
            {
                <option value="@raumID">Raum: @raumID</option>
            }
        </select>
        <select asp-for="Status" class="filter-auswahl d-none d-lg-block" data-auto-absenden aria-label="Status">
            <option value="">Status: alle</option>
            @foreach (var status in statusWerte)
            {
                <option value="@status">Status: @status</option>
            }
        </select>
    </form>

    @if (Model.Eintraege.Count == 0)
    {
        <p class="text-muted">Keine Geräte gefunden.</p>
    }
    else
    {
        @* Desktop: Tabelle, ein Klick auf die Zeile öffnet das Gerät *@
        <div class="blueprint d-none d-lg-block">
            <table class="table table-hover liste-tabelle katalog-tabelle">
                <thead>
                    <tr>
                        <th>Gerät</th>
                        <th>Seriennummer</th>
                        <th>Standort</th>
                        <th>Status</th>
                        <th>Hinweis</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var eintrag in Model.Eintraege)
                    {
                        <tr data-href="@Url.Action("Details", new { id = eintrag.Gegenstand.ID })">
                            <td>
                                <a class="zeilen-link fw-medium" asp-action="Details" asp-route-id="@eintrag.Gegenstand.ID">@eintrag.Gegenstand.Name</a>
                                <div class="nebeninfo">@Zusatz(eintrag)</div>
                            </td>
                            <td class="zahlen">@(eintrag.Gegenstand.Seriennummer ?? "–")</td>
                            <td>@(eintrag.Standort ?? "–")</td>
                            <td><span class="tag @StatusTag.Klasse(eintrag.Status)">@eintrag.Status</span></td>
                            <td>@(eintrag.Hinweis ?? "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Mobil: Liste mit Status und Standort *@
        <div class="d-lg-none">
            @foreach (var eintrag in Model.Eintraege)
            {
                <a class="katalog-zeile" asp-action="Details" asp-route-id="@eintrag.Gegenstand.ID">
                    <div class="katalog-zeile-text">
                        <span class="katalog-zeile-name">@eintrag.Gegenstand.Name</span>
                        <span class="nebeninfo katalog-zeile-info"><span class="tag tag-klein @StatusTag.Klasse(eintrag.Status)">@eintrag.Status</span>@(eintrag.Standort ?? "–")</span>
                    </div>
                </a>
            }
        </div>
    }
</div>
