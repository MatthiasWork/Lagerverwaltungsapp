@model Lagerverwaltungsapp_MatthiasUtrata.Models.GegenstandDetailsViewModel

@{
    var gegenstand = Model.Eintrag.Gegenstand;
    ViewData["Title"] = gegenstand.Name;

    var istAdmin = User.IsInRole("Admin");
    // Ein Transfer geht immer vom eigenen Raum aus, daher nur, wenn der Gegenstand dort liegt
    var kannTransfer = Model.EigenerRaumID != null && Model.Eintrag.Standorte.Any(r => r.RaumID == Model.EigenerRaumID);
    // Einbuchen in den eigenen Raum; ein Gerät mit Seriennummer nur, solange es weder in einem Raum liegt noch unterwegs ist
    var kannWareneingang = Model.EigenerRaumID != null
        && (gegenstand.Seriennummer == null || Model.Eintrag.Status == GegenstandUebersichtViewModel.KeinBestand);

    // Kennung auf dem Etikett und im Pfad: Seriennummer, ohne Seriennummer die ID
    var kennung = gegenstand.Seriennummer ?? $"ID {gegenstand.ID}";

    // Standort: der Raum mit der größten Menge, bei mehreren Räumen mit der Zahl der übrigen
    var ersterRaum = Model.Eintrag.Standorte.FirstOrDefault()?.Raum;
    var standort = ersterRaum == null ? "–"
        : $"{ersterRaum.ID} · {ersterRaum.Raumart.Name}" + (Model.Eintrag.Standorte.Count > 1 ? $" +{Model.Eintrag.Standorte.Count - 1}" : "");
    var verantwortlich = ersterRaum?.Person == null ? "–" : $"{ersterRaum.Person.Vorname} {ersterRaum.Person.Nachname}";
    var unterwegsStueck = Model.Unterwegs.Sum(l => l.Menge);

    var angaben = new (string Label, string Wert)[]
    {
        ("Seriennummer", gegenstand.Seriennummer ?? "–"),
        ("Kategorie", gegenstand.Kategorie.Name),
        ("Hersteller", gegenstand.Hersteller.Name),
        ("Standort", standort),
        ("Raumverantwortlich", verantwortlich),
        ("Bestand", $"{Model.Eintrag.Stueck} Stück" + (unterwegsStueck > 0 ? $" · {unterwegsStueck} unterwegs" : ""))
    };

    // Hinweis wie im Design, hier für die älteste Bewegung, die noch auf die Freigabe wartet (beim Holen aus einem Lager
    // durch die Person des Lagers, sonst durch die des Zielraums)
    var unterwegs = Model.Unterwegs.FirstOrDefault();
    var wartetAuf = unterwegs?.FreigabeRaum.Person == null ? "–" : $"{unterwegs.FreigabeRaum.Person.Vorname} {unterwegs.FreigabeRaum.Person.Nachname}";
    var unterwegsText = unterwegs != null && gegenstand.Seriennummer == null ? $"{unterwegs.Menge} Stück unterwegs" : "Unterwegs";

    // Datum im Verlauf: im laufenden Jahr ohne Jahreszahl
    string Datum(DateTime zeitpunkt) => zeitpunkt.Year == DateTime.Now.Year ? zeitpunkt.ToString("dd.MM.") : zeitpunkt.ToString("dd.MM.yy");
}

@* Desktop *@
<div class="seite geraet-detail d-none d-lg-flex">
    <nav class="brotkrumen" aria-label="Pfad">
        <a asp-action="Index">Katalog</a>
        <i data-lucide="chevron-right"></i>
        <a asp-action="Index" asp-route-kategorieID="@gegenstand.KategorieID">@gegenstand.Kategorie.Name</a>
        <i data-lucide="chevron-right"></i>
        <span>@kennung</span>
    </nav>

    <div class="detail-raster">
        <div class="detail-links">
            @* Beispiel aus dem Design: Fotos und QR-Etiketten gibt es noch nicht *@
            <div class="blueprint duotone geraet-foto"><span class="platzhalter-text">produktfoto</span></div>
            <div class="blueprint etikett">
                <div class="qr-code" aria-hidden="true"></div>
                <div class="etikett-text">
                    <span class="etikett-kennung">@kennung</span>
                    <button type="button" class="btn btn-outline-secondary"><i data-lucide="printer"></i>Etikett drucken</button>
                </div>
            </div>
        </div>

        <div class="detail-rechts">
            <div class="detail-titel">
                <span class="tag @StatusTag.Klasse(Model.Eintrag.Status)">@Model.Eintrag.Status</span>
                <h1>@gegenstand.Name</h1>
                <span class="detail-unterzeile">@gegenstand.Kategorie.Name · @(ersterRaum == null ? "kein Standort" : $"Standort {standort}")</span>
            </div>

            @if (unterwegs != null)
            {
                <div class="blueprint hinweis-box">
                    <i data-lucide="truck"></i>
                    <div class="hinweis-box-text">
                        <b>@unterwegsText von @unterwegs.VonRaumID nach @unterwegs.NachRaumID</b> seit @unterwegs.ErstelltAm.ToString("dd.MM."), gebucht von @unterwegs.Person.Vorname @unterwegs.Person.Nachname.
                        Wartet auf die Freigabe durch @wartetAuf.
                        @if (Model.Unterwegs.Count > 1)
                        {
                            <text>Dazu @(Model.Unterwegs.Count - 1) weitere Transfers.</text>
                        }
                    </div>
                    @* Freigeben darf nur, wer für den freigebenden Raum verantwortlich ist *@
                    @if (Model.EigenerRaumID == unterwegs.FreigabeRaum.ID)
                    {
                        <a class="btn btn-primary" asp-controller="Uebernahme" asp-action="Index">Freigeben</a>
                    }
                </div>
            }

            <div class="angaben-raster">
                @foreach (var angabe in angaben)
                {
                    <div class="angabe">
                        <span class="angabe-label">@angabe.Label</span>
                        <span>@angabe.Wert</span>
                    </div>
                }
            </div>

            @if (kannTransfer || kannWareneingang || istAdmin)
            {
                <div class="detail-aktionen">
                    @if (kannTransfer)
                    {
                        <a class="btn btn-outline-secondary" asp-controller="Ausleihe" asp-action="Index"><i data-lucide="arrow-right-left"></i>Transfer anfragen</a>
                    }
                    @if (kannWareneingang)
                    {
                        <a class="btn btn-outline-secondary" asp-controller="MeinRaum" asp-action="Wareneingang" asp-route-gegenstandID="@gegenstand.ID"><i data-lucide="package-plus"></i>Wareneingang in @Model.EigenerRaumID</a>
                    }
                    @* Den Katalog sehen alle, bearbeiten und löschen darf nur ein Admin *@
                    @if (istAdmin)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@gegenstand.ID"><i data-lucide="pencil"></i>Bearbeiten</a>
                        <a class="btn btn-outline-secondary" asp-action="Delete" asp-route-id="@gegenstand.ID"><i data-lucide="trash-2"></i>Löschen</a>
                    }
                </div>
            }

            @* Nicht im Design: Gegenstände ohne Seriennummer können in mehreren Räumen liegen *@
            @if (Model.Eintrag.Standorte.Count > 1)
            {
                <div class="bestand-liste">
                    <h4>Bestand in Räumen</h4>
                    @foreach (var bestand in Model.Eintrag.Standorte)
                    {
                        <div class="bestand-zeile">
                            <span>@bestand.RaumID · @bestand.Raum.Raumart.Name</span>
                            <span>@bestand.Menge</span>
                        </div>
                    }
                </div>
            }

            <div class="verlauf">
                <h4>Verlauf</h4>
                @for (var i = 0; i < Model.Verlauf.Count; i++)
                {
                    <div class="verlauf-zeile">
                        <span class="verlauf-datum">@Datum(Model.Verlauf[i].Zeitpunkt)</span>
                        <span class="verlauf-punkt @(i == 0 ? "aktuell" : null)" aria-hidden="true"></span>
                        <span>@Model.Verlauf[i].Text</span>
                    </div>
                }
                @if (Model.Verlauf.Count == 0)
                {
                    <p class="aktivitaet-leer">Noch keine Buchungen.</p>
                }
            </div>
        </div>
    </div>
</div>

@* Mobil: Foto über die ganze Breite, Angaben als Liste, Buttons unten *@
<div class="detail-mobil d-lg-none">
    <a class="zurueck-link" asp-action="Index"><i data-lucide="chevron-left"></i>Katalog</a>
    <div class="duotone geraet-foto geraet-foto-mobil"><span class="platzhalter-text">produktfoto</span></div>

    <div class="detail-mobil-inhalt">
        <span class="tag @StatusTag.Klasse(Model.Eintrag.Status)">@Model.Eintrag.Status</span>
        <div>
            <h2>@gegenstand.Name</h2>
            <div class="seiten-untertitel">@(gegenstand.Seriennummer ?? gegenstand.Kategorie.Name) · @standort</div>
        </div>
        @if (unterwegs != null)
        {
            <div class="hinweis-flaeche"><b>@unterwegsText nach @unterwegs.NachRaumID</b>, wartet auf die Freigabe durch @wartetAuf.</div>
        }
        @foreach (var angabe in angaben)
        {
            <div class="angabe-zeile">
                <span class="angabe-label">@angabe.Label</span>
                <span>@angabe.Wert</span>
            </div>
        }
    </div>

    @if (kannTransfer || kannWareneingang || istAdmin)
    {
        <div class="aktionsleiste">
            @if (kannTransfer)
            {
                <a class="btn btn-outline-secondary" asp-controller="Ausleihe" asp-action="Index">Transfer</a>
            }
            @if (kannWareneingang)
            {
                <a class="btn btn-outline-secondary" asp-controller="MeinRaum" asp-action="Wareneingang" asp-route-gegenstandID="@gegenstand.ID">Einbuchen</a>
            }
            @if (istAdmin)
            {
                <a class="btn btn-outline-secondary btn-icon" asp-action="Delete" asp-route-id="@gegenstand.ID" title="Löschen" aria-label="Löschen"><i data-lucide="trash-2"></i></a>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@gegenstand.ID">Bearbeiten</a>
            }
        </div>
    }
</div>
