@model Lagerverwaltungsapp_MatthiasUtrata.Models.MenueViewModel
@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.Controllers

@{
    // Welcher Menüpunkt zur aktuellen Seite gehört. Der Controllername aus dem ActionDescriptor ist immer gleich geschrieben,
    // egal wie die URL eingetippt wurde
    var aktion = ViewContext.ActionDescriptor as ControllerActionDescriptor;
    var aktiv = aktion?.ControllerName switch
    {
        "Home" => "Übersicht",
        "MeinRaum" when aktion.ActionName == "Wareneingang" => "Wareneingang",
        "MeinRaum" => "Mein Raum",
        "Gegenstand" => "Katalog",
        "Ausleihe" => "Ausleihen",
        "Lager" => "Aus dem Lager",
        "Uebernahme" => "Freigaben",
        "Raum" => "Raumliste",
        "Admin" or "Person" or "Rolle" => "Benutzer",
        // Profil einer anderen Person (mit ID, aus der Benutzerliste); das eigene hat keinen Menüpunkt
        "Profil" when ViewContext.RouteData.Values["id"] != null => "Benutzer",
        "Kategorie" => "Kategorien",
        "Hersteller" => "Hersteller",
        "Raumart" => "Raumarten",
        "Bewegungsart" => "Bewegungsarten",
        "Raumbestand" => "Lagerbestand",
        "Lagerbewegung" => "Historie",
        _ => null
    };

    // Name und Rolle für den Block unten in der Seitenleiste (Claims aus dem Login)
    var vorname = User.FindFirstValue(ClaimTypes.GivenName) ?? "";
    var nachname = User.FindFirstValue(ClaimTypes.Surname) ?? "";
    var initialen = Person.InitialenAus(vorname, nachname);
    var rolle = User.FindFirstValue(ClaimTypes.Role) ?? "";
    if (Model.RaumID != null)
    {
        rolle += $" · {Model.RaumID}";
    }

    // Ein Menüpunkt mit Lucide-Icon und optionalem Badge; hervorgehoben, wenn sein Text zur aktuellen Seite passt.
    // Mit Badge (z. B. offene Freigaben) ist der Text fett, damit gleich auffällt, dass dort etwas wartet
    async Task Eintrag(string text, string controller, string action, string icon, int badge = 0)
    {
        var istAktiv = text == aktiv;

        <a class="sidebar-link @(istAktiv ? "active" : null) @(badge > 0 ? "hat-badge" : null)" asp-area="" asp-controller="@controller" asp-action="@action" aria-current="@(istAktiv ? "page" : null)">
            <i data-lucide="@icon"></i>
            <span class="label">@text</span>
            @if (badge > 0)
            {
                @* Vorgelesen als "Freigaben 3 offen" *@
                <span class="sidebar-badge">@badge<span class="visually-hidden"> offen</span></span>
            }
        </a>
    }
}

<nav class="sidebar-nav" aria-label="Hauptmenü">
    @* Menüpunkte wie im Design. Wer was sieht, hängt von der Rolle (Admin) und davon ab, ob die Person einen Raum hat *@
    @{
        await Eintrag("Übersicht", "Home", "Index", "layout-dashboard");
    }
    @if (Model.RaumID != null)
    {
        await Eintrag("Mein Raum", "MeinRaum", "Index", "door-open");
        @* Neue Gegenstände in den Bestand des eigenen Raums einbuchen, daher wie "Mein Raum" nur mit eigenem Raum *@
        await Eintrag("Wareneingang", "MeinRaum", "Wareneingang", "package-plus");
    }
    @{
        await Eintrag("Katalog", "Gegenstand", "Index", "package");
        await Eintrag("Ausleihen", "Ausleihe", "Index", "handshake");
    }
    @if (Model.RaumID != null)
    {
        @* Geräte aus einem Lager in den eigenen Raum holen, daher wie "Mein Raum" nur mit eigenem Raum *@
        await Eintrag("Aus dem Lager", "Lager", "Index", "warehouse");
    }
    @if (Model.RaumID != null)
    {
        await Eintrag("Freigaben", "Uebernahme", "Index", "inbox", Model.OffeneUebernahmen);
    }
    @if (Model.IstAdmin)
    {
        await Eintrag("Benutzer", "Admin", "Index", "users");

        @* Stammdaten gibt es im Design nicht; sie bleiben für Admins unter den Menüpunkten des Designs erreichbar *@
        <div class="sidebar-section">Stammdaten</div>
        await Eintrag("Kategorien", "Kategorie", "Index", "tags");
        await Eintrag("Hersteller", "Hersteller", "Index", "factory");
        await Eintrag("Raumliste", "Raum", "Index", "door-closed");
        await Eintrag("Raumarten", "Raumart", "Index", "layout-grid");
        await Eintrag("Bewegungsarten", "Bewegungsart", "Index", "list");
        await Eintrag("Lagerbestand", "Raumbestand", "Index", "boxes");
        await Eintrag("Historie", "Lagerbewegung", "Index", "history");
    }
</nav>

<div class="sidebar-fuss">
    @* Wechselt zwischen hellem und dunklem Modus (site.js); die Wahl merkt sich der Browser.
       Ob der Schalter an ist, kommt aus site.css, da der Modus schon vor dem Zeichnen der Seite feststeht *@
    <button type="button" class="sidebar-link farbmodus-schalter" role="switch" aria-checked="false" data-farbmodus-schalter>
        <i data-lucide="moon"></i>
        <span class="label">Dark Mode</span>
        <span class="schalter" aria-hidden="true"></span>
    </button>

    <div class="sidebar-user">
        @* Name und Avatar führen zum eigenen Profil *@
        <a class="sidebar-user-link" asp-area="" asp-controller="Profil" asp-action="Index" asp-route-id="">
            <span class="avatar" aria-hidden="true">@initialen</span>
            <span class="sidebar-user-text">
                <span class="sidebar-user-name">@vorname @nachname</span>
                <span class="sidebar-user-role">@rolle</span>
            </span>
        </a>
        <form asp-area="" asp-controller="Home" asp-action="Logout" method="post">
            @* In der Seitenleiste nur das Icon, im Profil (mobil) mit Text *@
            <button type="submit" class="btn btn-outline-secondary btn-icon" title="Abmelden" aria-label="Abmelden">
                <i data-lucide="log-out"></i><span class="abmelden-text">Abmelden</span>
            </button>
        </form>
    </div>
</div>
