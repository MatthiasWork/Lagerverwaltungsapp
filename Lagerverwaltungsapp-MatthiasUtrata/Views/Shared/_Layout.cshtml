<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lagerverwaltung BS EVITA</title>
    <script type="importmap"></script>
    @* Schriften des Design-Systems: Barlow (Text) und Barlow Condensed (Überschriften) *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;700&family=Barlow+Condensed:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Seitenleiste: ab 992 px fest links, darunter über den Menü-Button als Offcanvas ausklappbar *@
        <aside class="sidebar offcanvas-lg offcanvas-start" id="sidebar" tabindex="-1" aria-label="Hauptmenü">
            <div class="offcanvas-header d-lg-none">
                <span class="sidebar-section m-0">Menü</span>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Menü schließen"></button>
            </div>
            <div class="offcanvas-body">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">B</span>
                    <span class="brand-text"><span class="brand-name">BS EVITA</span><span class="brand-sub">Lagerverwaltung</span></span>
                </a>
                @* Menüpunkte je nach Rolle und Zuständigkeit, siehe MenueViewComponent *@
                @await Component.InvokeAsync("Menue")
            </div>
        </aside>

        <div class="app-main">
            <header class="topbar d-lg-none">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">B</span>
                    <span class="brand-text"><span class="brand-name">BS EVITA</span><span class="brand-sub">Lagerverwaltung</span></span>
                </a>
                <button type="button" class="btn btn-outline-secondary btn-icon" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Menü öffnen">
                    <i data-lucide="menu"></i>
                </button>
            </header>
            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @* Ohne Anmeldung (Login, Registrierung): nur Logo und Inhalt, ohne Menü *@
        <main role="main" class="auth-page">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Login">
                <span class="brand-mark">B</span>
                <span class="brand-text"><span class="brand-name">BS EVITA</span><span class="brand-sub">Lagerverwaltung</span></span>
            </a>
            <div class="auth-box">
                @RenderBody()
            </div>
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
