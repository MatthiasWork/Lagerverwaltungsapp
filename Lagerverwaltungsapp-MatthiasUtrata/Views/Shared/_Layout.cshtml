<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · BSEVITA Geräteverleih</title>
    <script type="importmap"></script>
    @* Dark Mode: der gemerkte Modus (sonst der des Betriebssystems) muss feststehen, bevor die Seite gezeichnet wird,
       sonst blitzt sie beim Laden kurz hell auf. Daher hier direkt im <head> statt in site.js, dort ist der Schalter *@
    <script>
            (function () {
                var modus = null;
                try {
                    modus = localStorage.getItem('farbmodus');
                } catch (e) {
                    // Ohne Zugriff auf den Speicher (z. B. gesperrt im Browser) gilt der Modus des Betriebssystems
                }
                if (modus !== 'dark' && modus !== 'light') {
                    modus = 'light';
                    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                        modus = 'dark';
                    }
                }
                document.documentElement.setAttribute('data-bs-theme', modus);
            })();
    </script>
    @* Schriften des Design-Systems: Barlow (Text) und Barlow Condensed (Überschriften) *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;700&family=Barlow+Condensed:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Wie im Design: ab 992 px die Seitenleiste links (Desktop), darunter die Tab-Leiste unten (Mobil).
           Menüpunkte je nach Rolle und Zuständigkeit, siehe MenueViewComponent *@
        <aside class="sidebar d-none d-lg-flex" aria-label="Seitenleiste">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">B</span>
                <span class="brand-text"><span class="brand-name">BSEVITA</span><span class="brand-sub">Geräteverleih</span></span>
            </a>
            @await Component.InvokeAsync("Menue")
        </aside>

        <div class="app-main">
            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>

        @* Seiten im Vollbild (z. B. Scannen) blenden die Tab-Leiste mit ViewData["TabLeisteAusblenden"] = true aus *@
        @if (ViewData["TabLeisteAusblenden"] as bool? != true)
        {
            @await Component.InvokeAsync("Menue", new { ansicht = "TabLeiste" })
        }
    }
    else
    {
        @* Ohne Anmeldung (Login, Registrierung): nur Logo und Inhalt, ohne Menü *@
        <main role="main" class="auth-page">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Login">
                <span class="brand-mark">B</span>
                <span class="brand-text"><span class="brand-name">BSEVITA</span><span class="brand-sub">Geräteverleih</span></span>
            </a>
            <div class="auth-box">
                @RenderBody()
            </div>
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
