@model ErrorViewModel
@{
    ViewData["Title"] = "Fehler";
}

<h1 class="text-danger">Fehler</h1>
<h2 class="text-danger">Beim Verarbeiten der Anfrage ist ein Fehler aufgetreten.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Anfrage-ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Bitte versuche es noch einmal. Tritt der Fehler weiterhin auf, wende dich mit der Anfrage-ID an einen Admin.</p>

<div>
    <a asp-controller="Home" asp-action="Index">Zur Startseite</a>
</div>
