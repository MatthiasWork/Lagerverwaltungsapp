@model Lagerverwaltungsapp_MatthiasUtrata.Models.UebernahmeViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Freigaben";

    var kultur = new CultureInfo("de-AT");

    // Datum wie im Design: "Mo, 28.09."
    string Datum(DateTime zeitpunkt) => zeitpunkt.ToString("dddd", kultur)[..2] + zeitpunkt.ToString(", dd.MM.");

    // Karten: "vor 20 Min.", "vor 1 Std.", "gestern", sonst das Datum
    string Wann(DateTime zeitpunkt)
    {
        var vergangen = DateTime.Now - zeitpunkt;
        if (vergangen.TotalMinutes < 1)
        {
            return "gerade eben";
        }
        if (vergangen.TotalMinutes < 60)
        {
            return $"vor {(int)vergangen.TotalMinutes} Min.";
        }
        if (zeitpunkt.Date == DateTime.Today)
        {
            return $"vor {(int)vergangen.TotalHours} Std.";
        }
        if (zeitpunkt.Date == DateTime.Today.AddDays(-1))
        {
            return "gestern";
        }
        return Datum(zeitpunkt);
    }

    // Erledigt: "heute 07:48", "gestern 16:10", sonst das Datum
    string Erledigt(DateTime zeitpunkt)
    {
        if (zeitpunkt.Date == DateTime.Today)
        {
            return $"heute {zeitpunkt:HH:mm}";
        }
        if (zeitpunkt.Date == DateTime.Today.AddDays(-1))
        {
            return $"gestern {zeitpunkt:HH:mm}";
        }
        return Datum(zeitpunkt);
    }

    // Menge hinter dem Namen, z. B. "Tablet × 5"; bei einem Stück nichts
    string Menge(Lagerbewegung bewegung)
    {
        if (bewegung.Menge > 1)
        {
            return $" × {bewegung.Menge}";
        }
        return "";
    }

    // Unter dem Namen: Menge bzw. Seriennummer
    string Angabe(Lagerbewegung bewegung)
    {
        if (bewegung.Gegenstand.Seriennummer == null)
        {
            return $"{bewegung.Menge} Stück, ohne Seriennummer";
        }
        return $"Seriennummer {bewegung.Gegenstand.Seriennummer}";
    }
}

<div class="seite freigaben">
    <div class="seiten-kopf">
        <div>
            <h1>Freigaben</h1>
            @if (Model.Raum != null)
            {
                <div class="seiten-untertitel d-none d-lg-block">Anfragen für Ihren Raum @Model.Raum.ID · @Model.Raum.Raumart.Name</div>
                <div class="seiten-untertitel d-lg-none">@Model.Raum.ID · @Model.Offen.Count offen</div>
            }
        </div>
        @* Nicht im Design: mehrere Anfragen auf einmal freigeben *@
        @if (Model.Offen.Count > 1)
        {
            <form class="d-none d-lg-block" asp-action="Bestaetigen" method="post">
                @foreach (var bewegung in Model.Offen)
                {
                    <input type="hidden" name="ids" value="@bewegung.ID" />
                }
                <button type="submit" class="btn btn-outline-secondary"><i data-lucide="check-check"></i>Alle freigeben (@Model.Offen.Count)</button>
            </form>
        }
    </div>

    <partial name="_Meldungen" />

    @if (Model.Raum == null)
    {
        <p class="text-muted">Sie sind derzeit für keinen Raum verantwortlich, daher gibt es nichts freizugeben.</p>
    }
    else if (!Model.Offen.Any())
    {
        <p class="text-muted">Es warten keine Anfragen auf Ihre Freigabe.</p>
    }
    else
    {
        @* Jede Anfrage ist eine Lagerbewegung: eine Ausleihe in den eigenen Raum oder Geräte, die jemand aus dem eigenen Lager holt.
           "Freigeben" bestätigt sie und bucht die Geräte im Nach-Raum ein *@
        <div class="freigaben-raster">
            @foreach (var bewegung in Model.Offen)
            {
                <div class="blueprint freigabe-karte">
                    <div class="freigabe-kopf">
                        <span class="tag tag-outline">Ausleihe</span>
                        <span class="freigabe-zeit"><span class="d-lg-none">@bewegung.Person.Vorname @bewegung.Person.Nachname · </span>@Wann(bewegung.ErstelltAm)</span>
                    </div>
                    <h2 class="uebernahme-titel">@bewegung.Gegenstand.Name@Menge(bewegung)</h2>
                    <div class="route">
                        <i data-lucide="map-pin"></i>
                        <span>@bewegung.VonRaumID · @bewegung.VonRaum.Raumart.Name → @bewegung.NachRaumID · @bewegung.NachRaum.Raumart.Name</span>
                    </div>
                    <div class="freigabe-info d-none d-lg-block">
                        @bewegung.Bewegungsart.Name · @Angabe(bewegung)
                    </div>
                    <div class="karte-fuss d-none d-lg-flex">
                        <span class="avatar avatar-sm" aria-hidden="true">@bewegung.Person.Initialen</span>
                        <span class="freigabe-person">@bewegung.Person.Vorname @bewegung.Person.Nachname</span>
                    </div>
                    <form asp-action="Bestaetigen" method="post">
                        <input type="hidden" name="ids" value="@bewegung.ID" />
                        <button type="submit" class="btn btn-primary btn-cta w-100"><i data-lucide="check"></i>Freigeben</button>
                    </form>
                    @* Nicht im Design: Wer die Anfrage nicht freigeben will, lehnt sie ab und die Menge geht zurück in den Von-Raum *@
                    <form asp-action="Ablehnen" asp-route-id="@bewegung.ID" method="post"
                          data-bestaetigen="Anfrage ablehnen? @bewegung.Gegenstand.Name@Menge(bewegung) geht zurück in Raum @bewegung.VonRaumID.">
                        <button type="submit" class="btn btn-outline-secondary w-100"><i data-lucide="x"></i>Ablehnen</button>
                    </form>
                </div>
            }
        </div>
    }

    @* Im Mobil-Design gibt es die erledigten Anfragen nicht *@
    @if (Model.Erledigt.Any())
    {
        <section class="erledigt d-none d-lg-block">
            <h4>Erledigt</h4>
            <ul class="erledigt-liste">
                @foreach (var bewegung in Model.Erledigt)
                {
                    // Übernommen oder storniert (abgelehnt oder vom Von-Raum zurückgezogen)
                    var text = $"{bewegung.Gegenstand.Name}{Menge(bewegung)} · Ausleihe {bewegung.VonRaumID} → {bewegung.NachRaumID}";
                    var icon = "check";
                    if (bewegung.Storniert)
                    {
                        text += " · storniert";
                        icon = "x";
                    }
                    <li>
                        <i data-lucide="@icon"></i>
                        <span class="flex-grow-1">@text</span>
                        <span class="erledigt-zeit">@Erledigt(bewegung.BestaetigtAm!.Value)</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>
