@model Lagerverwaltungsapp_MatthiasUtrata.Models.Raumart

@{
    ViewData["Title"] = "Raumart löschen";
    var loeschHindernis = ViewData["LoeschHindernis"] as string;
}

<h1>Raumart löschen</h1>
<hr />

@if (loeschHindernis != null)
{
    <div class="alert alert-danger">@loeschHindernis</div>
}
else
{
    <h3>Soll diese Raumart wirklich gelöscht werden?</h3>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        @if (loeschHindernis == null)
        {
            <input type="submit" value="Löschen" class="btn btn-danger" />
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Zurück zur Übersicht</a>
    </form>
</div>
