@model IEnumerable<Lagerverwaltungsapp_MatthiasUtrata.Models.Raumart>

@{
    ViewData["Title"] = "Raumarten";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>Raumarten</h1>
    <a asp-action="Create" class="btn btn-primary"><i data-lucide="plus"></i>Neue Raumart</a>
</div>
<hr />

<p class="text-muted">
    Eine Raumart beschreibt einen Raum nur näher (z. B. Labor). Wer für einen Raum buchen und bestätigen darf,
    hängt nicht von der Raumart ab, sondern nur von der verantwortlichen Person des Raums.
</p>

<partial name="_Meldungen" />

@if (!Model.Any())
{
    <p class="text-muted">Es gibt noch keine Raumarten.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Räume</th>
                    <th class="text-end">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var raumart in Model)
                {
                    <tr>
                        <td>@raumart.Name</td>
                        <td>
                            @if (raumart.Raum.Any())
                            {
                                @(string.Join(", ", raumart.Raum.Select(r => r.ID).OrderBy(r => r)))
                            }
                            else
                            {
                                <span class="text-muted">keine</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@raumart.ID" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@raumart.ID" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
                            <a asp-action="Delete" asp-route-id="@raumart.ID" class="btn btn-sm btn-outline-danger">Löschen</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
