@{
    ViewData["Title"] = "Rückgaben";
}

<div class="seite rueckgaben">
    <div class="seiten-kopf">
        <h1>Rückgaben</h1>
        <a class="btn btn-primary d-none d-lg-inline-flex" asp-controller="Scan" asp-action="Index"><i data-lucide="scan-line"></i>Rückgabe scannen</a>
    </div>

    @* Regeln, Filter und die Liste der fälligen Ausleihen aus dem Design fehlen, da es Rückgabefristen im Datenmodell noch nicht gibt *@
    <div class="blueprint hinweis-box">
        <i data-lucide="calendar-clock"></i>
        <div class="hinweis-box-text">
            <b>Noch keine Rückgabefristen.</b>
            Geräte werden bisher nur zwischen Räumen ausgeborgt, nicht mit Rückgabedatum an Personen verliehen.
            Sobald es das gibt, stehen hier die überfälligen und bald fälligen Rückgaben.
        </div>
    </div>
</div>
