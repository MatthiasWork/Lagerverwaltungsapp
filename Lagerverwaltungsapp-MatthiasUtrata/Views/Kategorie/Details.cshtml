@model Lagerverwaltungsapp_MatthiasUtrata.Models.Kategorie

@{
    ViewData["Title"] = "Kategorie";
}

<h1>Kategorie</h1>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Gegenstände</dt>
        <dd class="col-sm-10">
            @Model.Gegenstand.Count
            <a asp-controller="Gegenstand" asp-action="Index" asp-route-kategorieID="@Model.ID">anzeigen</a>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary">Bearbeiten</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Zurück zur Übersicht</a>
</div>
