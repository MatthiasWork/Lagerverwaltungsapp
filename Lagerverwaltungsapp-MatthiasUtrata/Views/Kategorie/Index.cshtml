@model IEnumerable<Lagerverwaltungsapp_MatthiasUtrata.Models.Kategorie>

@{
    ViewData["Title"] = "Kategorien";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>Kategorien</h1>
    <a asp-action="Create" class="btn btn-primary"><i data-lucide="plus"></i>Neue Kategorie</a>
</div>
<hr />

<partial name="_Meldungen" />

@if (!Model.Any())
{
    <p class="text-muted">Es gibt noch keine Kategorien.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Gegenstände</th>
                    <th class="text-end">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kategorie in Model)
                {
                    <tr>
                        <td>@kategorie.Name</td>
                        <td>
                            <a asp-controller="Gegenstand" asp-action="Index" asp-route-kategorieID="@kategorie.ID">@kategorie.Gegenstand.Count</a>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@kategorie.ID" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@kategorie.ID" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
                            <a asp-action="Delete" asp-route-id="@kategorie.ID" class="btn btn-sm btn-outline-danger">Löschen</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
