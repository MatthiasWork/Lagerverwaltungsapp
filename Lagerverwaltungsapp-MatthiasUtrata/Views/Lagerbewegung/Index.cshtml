@model IEnumerable<Lagerverwaltungsapp_MatthiasUtrata.Models.Lagerbewegung>

@{
    ViewData["Title"] = "Historie";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>Historie</h1>
    @* Alle Lagerbewegungen als CSV-Datei, chronologisch nach dem Zeitpunkt der Buchung *@
    <a asp-action="Export" class="btn btn-primary"><i data-lucide="download"></i>CSV exportieren</a>
</div>
<hr />

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Menge)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ErstelltAm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BestaetigtAm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BewegungsartID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VonRaumID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NachRaumID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GegenstandID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PersonID)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Menge)
            </td>
            <td>
                @Html.DisplayFor(model => item.ErstelltAm)
            </td>
            <td>
                @Html.DisplayFor(model => item.BestaetigtAm)
            </td>
            <td>
                @Html.DisplayFor(model => item.BewegungsartID)
            </td>
            <td>
                @Html.DisplayFor(model => item.VonRaumID)
            </td>
            <td>
                @Html.DisplayFor(model => item.NachRaumID)
            </td>
            <td>
                @Html.DisplayFor(model => item.GegenstandID)
            </td>
            <td>
                @Html.DisplayFor(model => item.PersonID)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.ID">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>
