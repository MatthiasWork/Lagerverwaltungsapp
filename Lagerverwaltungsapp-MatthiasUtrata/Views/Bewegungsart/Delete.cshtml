@model Lagerverwaltungsapp_MatthiasUtrata.Models.Bewegungsart

@{
    ViewData["Title"] = "Bewegungsart löschen";

    // "Storniert" und "Korrektur" vergibt der LagerService selbst, daher können sie nicht gelöscht werden (siehe BewegungsartController)
    var nurVergebenFuer = Bewegungsart.NurVergebenFuer(Model.Name);
}

<h1>Bewegungsart löschen</h1>
<hr />

@if (nurVergebenFuer != null)
{
    <div class="alert alert-danger">Die Bewegungsart "@Model.Name" bekommen @nurVergebenFuer, daher kann sie nicht gelöscht werden.</div>
}
else
{
    <h3>Soll diese Bewegungsart wirklich gelöscht werden?</h3>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        @if (nurVergebenFuer == null)
        {
            <input type="submit" value="Löschen" class="btn btn-danger" />
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Zurück zur Übersicht</a>
    </form>
</div>
