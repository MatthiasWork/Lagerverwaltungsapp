@model Lagerverwaltungsapp_MatthiasUtrata.Models.Raum

@{
    ViewData["Title"] = "Raum bearbeiten";
}

<h1>Raum @Model.ID bearbeiten</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @* Die Raumnummer ist der Primärschlüssel und kann daher nicht geändert werden *@
            <input type="hidden" asp-for="ID" />

            <div class="form-group">
                <label asp-for="RaumartID" class="control-label"></label>
                <select asp-for="RaumartID" class="form-select" asp-items="ViewBag.RaumartID"></select>
                <span asp-validation-for="RaumartID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PersonID" class="control-label"></label>
                <select asp-for="PersonID" class="form-select" asp-items="ViewBag.PersonID">
                    <option value="">Bitte auswählen</option>
                </select>
                <span asp-validation-for="PersonID" class="text-danger"></span>
                <div class="form-text">
                    Eine Person kann nur für einen Raum verantwortlich sein, daher werden nur Personen ohne anderen Raum angeboten.
                    Eine neue Person ist ab sofort zuständig, auch für schon offene Lagerbewegungen.
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Speichern" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
