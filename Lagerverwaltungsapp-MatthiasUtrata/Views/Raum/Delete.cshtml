@model Lagerverwaltungsapp_MatthiasUtrata.Models.Raum

@{
    ViewData["Title"] = "Raum löschen";
    var loeschHindernis = ViewData["LoeschHindernis"] as string;
}

<h1>Raum löschen</h1>
<hr />

@if (loeschHindernis != null)
{
    <div class="alert alert-danger">@loeschHindernis</div>
}
else
{
    <h3>Soll dieser Raum wirklich gelöscht werden?</h3>
}

<div>
    <dl class="row">
        <dt class="col-sm-3">Raumnummer</dt>
        <dd class="col-sm-9">@Model.ID</dd>

        <dt class="col-sm-3">Raumart</dt>
        <dd class="col-sm-9">@Model.Raumart.Name</dd>

        <dt class="col-sm-3">Verantwortliche Person</dt>
        <dd class="col-sm-9">@(Model.Person?.VollerName ?? "–")</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        @if (loeschHindernis == null)
        {
            <input type="submit" value="Löschen" class="btn btn-danger" />
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Zurück zur Übersicht</a>
    </form>
</div>
