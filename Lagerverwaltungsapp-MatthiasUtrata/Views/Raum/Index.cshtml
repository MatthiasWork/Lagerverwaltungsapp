@model IEnumerable<Lagerverwaltungsapp_MatthiasUtrata.Models.Raum>

@{
    ViewData["Title"] = "Räume";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>Räume</h1>
    <a asp-action="Create" class="btn btn-primary"><i data-lucide="plus"></i>Neuer Raum</a>
</div>
<hr />

<partial name="_Meldungen" />

@if (!Model.Any())
{
    <p class="text-muted">Es gibt noch keine Räume.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Raumnummer</th>
                    <th>Raumart</th>
                    <th>Verantwortliche Person</th>
                    <th class="text-end">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var raum in Model)
                {
                    <tr>
                        <td>@raum.ID</td>
                        <td>@raum.Raumart.Name</td>
                        <td>
                            @if (raum.Person != null)
                            {
                                <text>@raum.Person.Vorname @raum.Person.Nachname</text>
                            }
                            else
                            {
                                <span class="tag tag-dark">keine – bitte zuweisen</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@raum.ID" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@raum.ID" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
                            <a asp-action="Delete" asp-route-id="@raum.ID" class="btn btn-sm btn-outline-danger">Löschen</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
