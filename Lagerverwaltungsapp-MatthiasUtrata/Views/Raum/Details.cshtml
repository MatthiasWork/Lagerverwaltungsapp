@model Lagerverwaltungsapp_MatthiasUtrata.Models.Raum

@{
    ViewData["Title"] = "Raum";
}

<h1>Raum @Model.ID</h1>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-3">Raumart</dt>
        <dd class="col-sm-9">@Model.Raumart.Name</dd>

        <dt class="col-sm-3">Verantwortliche Person</dt>
        <dd class="col-sm-9">
            @if (Model.Person != null)
            {
                <a asp-controller="Person" asp-action="Details" asp-route-id="@Model.Person.ID">@Model.Person.Vorname @Model.Person.Nachname</a>
                <span class="text-muted">(@Model.Person.Username)</span>
            }
            else
            {
                <span class="tag tag-dark">keine – bitte zuweisen</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary">Bearbeiten</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Zurück zur Übersicht</a>
</div>
