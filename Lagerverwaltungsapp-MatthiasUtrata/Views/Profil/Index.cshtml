@model Lagerverwaltungsapp_MatthiasUtrata.Models.ProfilViewModel

@{
    var person = Model.Person;
    var istAdmin = User.IsInRole("Admin");

    // Offene Ausleihen, die die Person angelegt hat, je Von- und Nach-Raum zusammengefasst (z. B. "HL → 310")
    var anfragen = Model.OffeneAusleihen.GroupBy(l => $"{l.VonRaumID} → {l.NachRaumID}").ToList();
    string anfragenTitel;
    if (Model.IstEigenesProfil)
    {
        ViewData["Title"] = "Mein Profil";
        anfragenTitel = "Meine Anfragen";
    }
    else
    {
        ViewData["Title"] = person.VollerName;
        anfragenTitel = "Anfragen";
    }

    // Räume, für die die Person verantwortlich ist, z. B. "HL · Hauptlager", und was das für sie bedeutet
    var raeume = person.Raum.OrderBy(r => r.ID).ToList();
    string? raumText = null;
    string raumInfo;
    string rolleMitRaeumen = person.Rolle.Name;
    if (raeume.Count == 0)
    {
        raumInfo = "Nicht für einen Raum verantwortlich";
    }
    else
    {
        raumText = string.Join(", ", raeume.Select(r => $"{r.ID} · {r.Raumart.Name}"));
        rolleMitRaeumen += $" · verantwortlich für {string.Join(", ", raeume.Select(r => r.ID))}";

        string welche;
        if (raeume.Count == 1)
        {
            welche = "diesen Raum";
        }
        else
        {
            welche = "diese Räume";
        }
        raumInfo = $"{Model.StueckJeRaum.Values.Sum()} Geräte · gibt Anfragen für {welche} frei";
    }

    // Verlauf: "Heute", "Gestern", sonst das Datum
    string Datum(DateTime zeitpunkt)
    {
        if (zeitpunkt.Date == DateTime.Today)
        {
            return "Heute";
        }
        if (zeitpunkt.Date == DateTime.Today.AddDays(-1))
        {
            return "Gestern";
        }
        return zeitpunkt.ToString("dd.MM.");
    }

    // "L. Brandt" für den Tag "wartet auf ..."
    string Kurzname(Person? p)
    {
        if (p == null)
        {
            return "–";
        }
        if (p.Vorname.Length == 0)
        {
            return p.Nachname;
        }
        return $"{p.Vorname[..1]}. {p.Nachname}";
    }

    // Beschreibung einer Anfrage: erster Gegenstand und wie viele Positionen noch dazugehören
    string AnfrageText(IGrouping<string, Lagerbewegung> anfrage)
    {
        var text = anfrage.First().Gegenstand.Name;
        if (anfrage.Count() > 1)
        {
            text += $" + {anfrage.Count() - 1} Pos.";
        }
        return text;
    }
}

@* Desktop *@
<div class="seite profil d-none d-lg-flex">
    <div class="profil-kopf">
        <span class="avatar" aria-hidden="true">@person.Initialen</span>
        <div class="profil-name">
            <h1>@person.Vorname @person.Nachname</h1>
            <div class="seiten-untertitel">@person.Rolle.Name · @(raumText ?? "kein Raum") · @person.Email</div>
        </div>
        @* Rolle und Konto ändert nur ein Admin; das eigene Konto kann er nicht löschen *@
        @if (istAdmin)
        {
            <a class="btn btn-outline-secondary" asp-controller="Person" asp-action="Edit" asp-route-id="@person.ID">Rolle ändern</a>
            @if (!Model.IstEigenesProfil)
            {
                <a class="btn btn-outline-secondary" asp-controller="Person" asp-action="Delete" asp-route-id="@person.ID">Löschen</a>
            }
        }
    </div>

    <div class="profil-raster">
        @* Statt "Aktuelle Ausleihen" aus dem Design (Verleih an Personen gibt es noch nicht) die offenen Anfragen wie mobil *@
        <div class="blueprint profil-karte breit">
            <span class="card-kicker">@anfragenTitel · @anfragen.Count</span>
            @foreach (var anfrage in anfragen)
            {
                <div class="anfrage-zeile">
                    <span><b class="fw-medium">Ausleihe @anfrage.Key</b><br /><span class="nebeninfo">@AnfrageText(anfrage)</span></span>
                    <span class="tag tag-accent">wartet auf @Kurzname(anfrage.First().FreigabeRaum.Person)</span>
                </div>
            }
            @if (anfragen.Count == 0)
            {
                <p class="aktivitaet-leer">Keine offenen Anfragen.</p>
            }
        </div>

        <div class="blueprint profil-karte">
            <span class="card-kicker">Raumverantwortung</span>
            <div class="raum-titel">@(raumText ?? "Kein Raum")</div>
            <div class="profil-info">@raumInfo</div>
        </div>

        <div class="blueprint profil-karte profil-verlauf">
            <span class="card-kicker">Verlauf</span>
            @foreach (var eintrag in Model.Verlauf)
            {
                <div class="profil-verlauf-zeile">
                    <span class="verlauf-datum">@Datum(eintrag.Zeitpunkt)</span>
                    <span>@eintrag.Text</span>
                </div>
            }
            @if (Model.Verlauf.Count == 0)
            {
                <p class="aktivitaet-leer">Noch keine Buchungen.</p>
            }
        </div>
    </div>
</div>

@* Mobil *@
<div class="seite profil-mobil d-lg-none">
    <div class="profil-kopf">
        <span class="avatar" aria-hidden="true">@person.Initialen</span>
        <div>
            <h1>@person.Vorname @person.Nachname</h1>
            <div class="profil-rolle">@rolleMitRaeumen</div>
        </div>
    </div>

    @* "Meine Ausleihen" aus dem Design fehlt, da es Verleih an Personen noch nicht gibt *@
    <section>
        <h6>@anfragenTitel</h6>
        @foreach (var anfrage in anfragen)
        {
            <div class="profil-zeile">
                <span>
                    <b class="fw-medium">Ausleihe @anfrage.Key</b><br />
                    <span class="nebeninfo">@AnfrageText(anfrage)</span>
                </span>
                <span class="tag tag-outline">wartet auf @Kurzname(anfrage.First().FreigabeRaum.Person)</span>
            </div>
        }
        @if (anfragen.Count == 0)
        {
            <p class="aktivitaet-leer">Keine offenen Anfragen.</p>
        }
    </section>

    @* Nicht im Design: Mobil gibt es keine Seitenleiste, daher hier alle Bereiche und Abmelden *@
    @if (Model.IstEigenesProfil)
    {
        <section class="profil-menue">
            <h6>Alle Bereiche</h6>
            @await Component.InvokeAsync("Menue")
        </section>
    }
</div>
